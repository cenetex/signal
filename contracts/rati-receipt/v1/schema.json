{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rati:receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "subject",
    "claim",
    "rules",
    "facts",
    "result",
    "outcome",
    "evaluated_at_unix_ms",
    "validity",
    "issuer",
    "sha256"
  ],
  "properties": {
    "schema": {
      "const": "rati.receipt.v1"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "content"
      ],
      "properties": {
        "media_type": {
          "const": "application/json"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "content"
      ],
      "properties": {
        "media_type": {
          "const": "application/json"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "evaluated_at_unix_ms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "validity": {
      "const": "snapshot"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
