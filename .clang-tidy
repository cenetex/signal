---
# clang-tidy editor configuration for Signal (C11)
#
# Focus on bug-finding and correctness for owned C. Skip style/naming checks
# and exclude third-party headers through HeaderFilterRegex. This file supports
# local/editor analysis; docs/c_safety_policy.md records which analyzers are
# actually blocking CI.

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-assignment-in-if-condition,
  performance-*,
  portability-*,
  misc-redundant-expression,
  misc-unused-using-decls,

# Treat enabled checks as advisory warnings.
WarningsAsErrors: ''

CheckOptions:
  # Allow short variable names (C style)
  - key: readability-identifier-length.MinimumVariableNameLength
    value: '1'

# Only report diagnostics from owned headers, not system/vendor headers.
HeaderFilterRegex: '(client|server|shared)/.*\.h$'
