#!/bin/bash
# Pre-push hook: block only on a known failed local verdict for the commit
# being pushed.
#
# The post-commit hook writes its asynchronous fast-test verdict to
# /tmp/signal-local-test.log. When that verdict matches HEAD, honor it:
#   - PASSED: allow immediately
#   - FAILED / BUILD FAILED: block the push
#
# Missing or stale verdicts do not start a long local test run by default.
# PR checks are the authoritative gate for full confidence. This keeps
# `git push` cheap and avoids training contributors to use --no-verify.
#
# Strict override: `SIGNAL_PRE_PUSH_STRICT=1 git push` restores the old
# synchronous fallback and blocks until the local suite passes.
set -eu

ROOT=$(git rev-parse --show-toplevel)
HEAD=$(git rev-parse --short HEAD)
LOG=/tmp/signal-local-test.log
STRICT=${SIGNAL_PRE_PUSH_STRICT:-0}

if grep -qE "PASSED at $HEAD" "$LOG" 2>/dev/null; then
    echo "pre-push: tests pass at $HEAD (cached)"
    exit 0
fi

if grep -qE "(FAILED|BUILD FAILED) at $HEAD" "$LOG" 2>/dev/null; then
    echo "pre-push: BLOCKED — tests failed at $HEAD"
    echo "  Last 20 log lines from $LOG:"
    tail -20 "$LOG" | sed 's/^/  | /'
    echo
    echo "  Fix and amend, then push again. To override: git push --no-verify"
    exit 1
fi

if [ "$STRICT" != "1" ]; then
    echo "pre-push: no cached local verdict for $HEAD — allowing push"
    echo "  PR checks are the authoritative gate."
    echo "  To force a local blocking run: SIGNAL_PRE_PUSH_STRICT=1 git push"
    exit 0
fi

echo "pre-push: no cached verdict for $HEAD — strict mode running tests synchronously..."
cd "$ROOT"
if ! cmake -S . -B build-test -DBUILD_TESTS_ONLY=ON -DGIT_HASH="$HEAD" >/dev/null 2>&1; then
    echo "pre-push: BLOCKED — cmake configure failed"
    exit 1
fi
if ! cmake --build build-test --parallel >/dev/null 2>&1; then
    echo "pre-push: BLOCKED — build failed"
    exit 1
fi
if ! "$ROOT/scripts/run_signal_test.sh" "$ROOT/build-test/signal_test" --quiet; then
    echo "pre-push: BLOCKED — synchronous test run failed"
    exit 1
fi
echo "pre-push: tests pass at $HEAD (synchronous)"
exit 0
