{
  "version": 1,
  "lanes": {
    "policy": "Path inventory, workflow contracts, and script syntax",
    "native": "Linux native tests, sanitizers, and static analysis",
    "soak": "Long-horizon native functional tests",
    "fuzz": "Receipt, handoff, and vendored-crypto fuzzing",
    "browser": "Release WebAssembly build and Chromium smoke",
    "container": "Clean production-container build and dependency audit",
    "cross_platform": "Linux, macOS ARM/Metal, and Windows/MSVC client and server compile",
    "replay": "Native/WASM deterministic replay comparison",
    "tools": "Standalone C command-line tools and packnft tests",
    "programs": "Locked Rust checks and tests for the burn-to-mint programs"
  },
  "always_lanes": [
    "policy"
  ],
  "categories": [
    {
      "name": "core-runtime",
      "scope": "shipping",
      "paths": [
        "client/**",
        "server/**",
        "shared/**"
      ],
      "lanes": [
        "native",
        "soak",
        "browser",
        "container",
        "cross_platform",
        "replay"
      ]
    },
    {
      "name": "vendored-runtime",
      "scope": "shipping",
      "paths": [
        "vendor/**"
      ],
      "lanes": [
        "native",
        "soak",
        "fuzz",
        "browser",
        "container",
        "cross_platform",
        "replay"
      ]
    },
    {
      "name": "fuzz-inputs",
      "scope": "test",
      "paths": [
        "tests/fuzz/**",
        "shared/cargo_receipt.c",
        "shared/cargo_receipt.h",
        "shared/commodity.c",
        "shared/commodity.h",
        "shared/handoff_ticket.c",
        "shared/handoff_ticket.h",
        "shared/manifest.c",
        "shared/manifest.h",
        "shared/signal_crypto.h",
        "vendor/tweetnacl/**"
      ],
      "lanes": [
        "fuzz"
      ]
    },
    {
      "name": "build-system",
      "scope": "gate",
      "paths": [
        "CMakeLists.txt",
        "Makefile"
      ],
      "lanes": [
        "native",
        "soak",
        "fuzz",
        "browser",
        "container",
        "cross_platform",
        "replay",
        "tools"
      ]
    },
    {
      "name": "native-tests",
      "scope": "test",
      "paths": [
        "tests/c/**",
        "tests/fixtures/**"
      ],
      "lanes": [
        "native",
        "soak"
      ]
    },
    {
      "name": "browser-runtime",
      "scope": "shipping",
      "paths": [
        "assets/**",
        "web/**"
      ],
      "lanes": [
        "browser",
        "container"
      ]
    },
    {
      "name": "browser-test-config",
      "scope": "test",
      "paths": [
        "playwright.config.ts",
        "tests/browser-smoke.spec.ts"
      ],
      "lanes": [
        "browser"
      ]
    },
    {
      "name": "node-package",
      "scope": "shipping",
      "paths": [
        "package.json",
        "package-lock.json"
      ],
      "lanes": [
        "browser",
        "container"
      ]
    },
    {
      "name": "production-container",
      "scope": "shipping",
      "paths": [
        ".dockerignore",
        "server/Dockerfile",
        "scripts/fly-webrtc-entrypoint.sh",
        "scripts/lightsail-webrtc-entrypoint.sh",
        "scripts/webrtc-gateway.mjs"
      ],
      "lanes": [
        "container"
      ]
    },
    {
      "name": "native-quality-config",
      "scope": "gate",
      "paths": [
        ".clang-tidy",
        "cppcheck.suppressions"
      ],
      "lanes": [
        "native"
      ]
    },
    {
      "name": "standalone-tools",
      "scope": "shipping",
      "paths": [
        "tools/**"
      ],
      "lanes": [
        "native",
        "tools"
      ]
    },
    {
      "name": "replay-gate",
      "scope": "gate",
      "paths": [
        "tools/signal_replay.c",
        "scripts/build_replay_bundle.py",
        "scripts/check_deterministic_build_flags.py",
        "scripts/check_replay_bundles.py",
        "scripts/check_replay_cross_build.py",
        "scripts/check_replay_repeatability.py"
      ],
      "lanes": [
        "replay"
      ]
    },
    {
      "name": "test-launch-and-soak-gates",
      "scope": "gate",
      "paths": [
        "scripts/check_soak_automation.py",
        "scripts/run_signal_test.sh",
        "scripts/test_check_soak_automation.py",
        "scripts/test-ws-backpressure-soak.mjs",
        "scripts/ws-backpressure-soak.mjs"
      ],
      "lanes": [
        "native",
        "soak"
      ]
    },
    {
      "name": "container-gates",
      "scope": "gate",
      "paths": [
        "scripts/check_container_workflow_inputs.py",
        "scripts/check_vendor_drift.sh",
        "scripts/test_check_container_workflow_inputs.py",
        "scripts/test_vendor_drift_detection.sh"
      ],
      "lanes": [
        "container"
      ]
    },
    {
      "name": "ci-controller",
      "scope": "gate",
      "paths": [
        ".github/ci-paths.json",
        ".github/workflows/ci.yml"
      ],
      "lanes": [
        "native",
        "soak",
        "fuzz",
        "browser",
        "container",
        "cross_platform",
        "replay",
        "tools",
        "programs"
      ]
    },
    {
      "name": "replay-workflow",
      "scope": "gate",
      "paths": [
        ".github/workflows/replay.yml"
      ],
      "lanes": [
        "replay"
      ]
    },
    {
      "name": "release-workflow",
      "scope": "gate",
      "paths": [
        ".github/workflows/release.yml"
      ],
      "lanes": [
        "native",
        "browser",
        "container",
        "cross_platform"
      ]
    },
    {
      "name": "deploy-workflow",
      "scope": "gate",
      "paths": [
        ".github/workflows/deploy-fly.yml"
      ],
      "lanes": [
        "native",
        "browser",
        "container"
      ]
    },
    {
      "name": "specialized-workflows",
      "scope": "gate",
      "paths": [
        ".github/workflows/soak.yml",
        ".github/workflows/valgrind.yml"
      ],
      "lanes": [
        "native",
        "soak"
      ]
    },
    {
      "name": "workflow-and-script-policy",
      "scope": "gate",
      "paths": [
        ".github/workflows/**",
        "scripts/**"
      ],
      "lanes": []
    },
    {
      "name": "deployment-config",
      "scope": "shipping",
      "paths": [
        "aws/**",
        "deploy/**",
        "docker/**",
        "fly.toml",
        "workers/**",
        "wrangler.toml"
      ],
      "lanes": [
        "container"
      ]
    },
    {
      "name": "independent-solana-programs",
      "scope": "shipping",
      "reason": "Built and released independently of the Signal CMake, npm, and Docker artifacts.",
      "paths": [
        "programs/**"
      ],
      "lanes": [
        "programs"
      ]
    },
    {
      "name": "contributor-guidance",
      "scope": "non-shipping",
      "reason": "Documentation and contributor instructions do not alter a release artifact.",
      "paths": [
        ".github/AGENT.md",
        "ARCHITECTURE.md",
        "CLAUDE.md",
        "CONSTRUCTION_PLAN.md",
        "ENG.md",
        "LICENSE",
        "PRD.md",
        "README.md",
        "REMEDIATION_PLAN.md",
        "docs/**"
      ],
      "lanes": []
    },
    {
      "name": "research-and-corpus",
      "scope": "non-shipping",
      "reason": "Tracked research inputs and local benchmark records are not packaged.",
      "paths": [
        "corpus/**",
        "perf/**"
      ],
      "lanes": []
    },
    {
      "name": "repository-metadata",
      "scope": "non-shipping",
      "reason": "Repository-local metadata is not consumed by builds or deployments.",
      "paths": [
        ".gitignore",
        ".irys-manifest-tx",
        "nohup.out"
      ],
      "lanes": []
    }
  ]
}
